+# =============================================================================
+# Cobertura del motor, contada desde params/ (para que no se desfase).
+#
+#   Rscript tools/generar_cobertura.R              # escribe web/datos/cobertura.json y la
+#                                                  # parte automática de docs/02_cobertura.md
+#   Rscript tools/generar_cobertura.R --comprobar  # CI: falla si alguno no sale de params/
+#
+# Para cada ejercicio con carpeta en params/ (herencia resuelta con leer_params()):
+#   - por comunidad de régimen común: deducciones autonómicas cargadas, cuántas están
+#     verificadas y cuántas no, frente al total aproximado del Manual de la AEAT
+#     (tools/cobertura_catalogo.yaml);
+#   - todos los bloques de params/ con `estado` que NO están verificados.
+#
+# «Verificado» = `estado: confirmado` Y una fuente oficial (BOE, boletines autonómicos y
+# forales, AEAT, Ministerio de Hacienda, haciendas forales). Un bloque confirmado cuya
+# fuente solo cita otras webs (Iberley, guiafiscal.es, despachos…) cuenta como «sin fuente
+# oficial». Una deducción sin `estado` propio está cargada pero sin cotejo individual.
+# La nota de cada parámetro es el comentario de su línea `estado:` en el YAML.
+#
+# La web lee web/datos/cobertura.json: la página «Qué calcula y qué no» (/que-calcula/,
+# tools/seo_cobertura.mjs) y los avisos de la calculadora (web/js/cobertura.js).
+# `generado` es la fecha del último cambio de contenido (no se toca si nada cambia).
+# =============================================================================
+source("R/cargar.R"); irpfsim_cargar(".")
+
+CATALOGO <- yaml::read_yaml("tools/cobertura_catalogo.yaml")
+DESTINO_JSON <- "web/datos/cobertura.json"
+DOC <- "docs/02_cobertura.md"
+MARCA_INI <- "<!-- cobertura:auto (tools/generar_cobertura.R; no editar a mano) -->"
+MARCA_FIN <- "<!-- /cobertura:auto -->"
+
+# ---- fuente oficial -----------------------------------------------------------------
+# Un identificador concreto de una fuente oficial. Un «BON» o «BOE» suelto, sin número ni
+# fecha, no basta (p. ej. «BON; guiafiscal.es»).
+OFICIAL <- paste0(
+  "BOE-A-|boe\\.es|\\bBOE\\b[^;]{0,60}[0-9]|Manual Pr[aá]ctico|\\bAEAT\\b|Agencia Tributaria|agenciatributaria|",
+  "hacienda\\.gob\\.es|Ministerio de Hacienda|SGFAL|Hacienda Foral|Diputaci[oó]n Foral|",
+  "\\bDF (Gipuzkoa|Bizkaia|Araba|[ÁA]lava)|\\bDF[BGA]\\b|Modelo 109|bizkaia\\.eus|gipuzkoa\\.eus|araba\\.eus|navarra\\.es|",
+  "\\b(BOB|BOG|BOTHA|BON|DOGC|DOE|BOJA|BOCM|BOPA|BOC|BORM|BOA|DOCM|BOCYL|BOCyL|DOG|BOIB|BOR|DOGV|DOCV)\\b\\s*(n[uú]m|n\\.?\\s?º|[0-9])")
+es_oficial <- function(fuente) !is.null(fuente) && nzchar(fuente) && grepl(OFICIAL, fuente, perl = TRUE)
+
+nivel_de <- function(estado, fuente) {
+  if (is.null(estado)) return("sin_cotejar")
+  switch(estado,
+    confirmado = if (es_oficial(fuente)) "verificado" else if (is.null(fuente) || !nzchar(fuente)) "sin_fuente" else "sin_fuente_oficial",
+    cargado = "sin_cotejar",
+    estado)                       # provisional, pendiente, parcial, no_aplica…
+}
+
+# ---- notas: el comentario de la línea `estado:` de cada bloque ------------------------
+# Devuelve ruta -> nota, con la ruta como en el YAML (claves y `id` de las listas, sin
+# `lista`). Recorre la cadena de herencia: el hijo pisa al padre.
+notas_fichero <- function(ruta) {
+  lin <- readLines(ruta, encoding = "UTF-8", warn = FALSE)
+  pila <- list(); out <- list()
+  for (l in lin) {
+    if (grepl("^\\s*(#|$)", l)) next
+    ind <- nchar(sub("^(\\s*).*$", "\\1", l))
+    m_id <- regmatches(l, regexec("^(\\s*)- id:\\s*\"?([A-Za-z0-9_]+)", l))[[1]]
+    m_k  <- regmatches(l, regexec("^(\\s*)([A-Za-z0-9_-]+):", l))[[1]]
+    clave <- if (length(m_id)) m_id[3] else if (length(m_k)) m_k[3] else next
+    while (length(pila) && pila[[length(pila)]]$ind >= ind) pila[[length(pila)]] <- NULL
+    camino <- vapply(pila, `[[`, "", "k")
+    if (clave == "estado") {
+      nota <- regmatches(l, regexec("#\\s*(.+?)\\s*$", l))[[1]]
+      if (length(nota)) out[[paste(setdiff(camino, "lista"), collapse = ".")]] <- nota[2]
+    }
+    pila[[length(pila) + 1]] <- list(ind = ind, k = clave)
+  }
+  out
+}
+notas_params <- function(ejercicio, fichero, base = .params_dir()) {
+  ruta <- file.path(base, as.character(ejercicio), fichero)
+  cadena <- character()
+  while (!is.null(ruta)) {
+    cadena <- c(ruta, cadena)
+    padre <- yaml::read_yaml(ruta)$meta$hereda_de
+    ruta <- if (is.null(padre)) NULL else file.path(base, padre)
+  }
+  out <- list()
+  for (r in cadena) { n <- notas_fichero(r); out[names(n)] <- n }
+  out
+}
+
+# ---- bloques con estado ---------------------------------------------------------------
+etiqueta <- function(fichero, clave_rel) CATALOGO$etiquetas[[paste0(fichero, ".", clave_rel)]]
+# Fuente de todo un fichero (cabecera de params/<año>/estatal.yaml: la LIRPF consolidada del
+# BOE). Solo vale para los bloques cuya `norma` es esa misma ley.
+fuente_fichero <- function(fichero, norma) {
+  f <- CATALOGO$fuente_fichero[[fichero]]
+  if (is.null(f) || is.null(norma) || !grepl(f$si_norma, norma, perl = TRUE)) NULL else f$fuente
+}
+sin_etiqueta <- character()
+humanizar <- function(k) { k <- gsub("_", " ", k); paste0(toupper(substring(k, 1, 1)), substring(k, 2)) }
+
+bloques_con_estado <- function(x, camino, fuente_padre, notas, ambito, fichero) {
+  out <- list()
+  if (!is.list(x) || is.null(names(x))) return(out)
+  fuente <- if (is.character(x[["fuente"]])) x[["fuente"]] else fuente_padre
+  if (length(camino) && is.character(x[["estado"]]) && length(x[["estado"]]) == 1) {
+    rel <- paste(camino, collapse = ".")
+    fuente_b <- fuente %||% fuente_fichero(fichero, x[["norma"]])
+    nv <- nivel_de(x[["estado"]], fuente_b)
+    if (nv != "verificado" && nv != "no_aplica") {
+      et <- etiqueta(fichero, rel)
+      if (is.null(et)) sin_etiqueta <<- unique(c(sin_etiqueta, paste0(fichero, ":", rel)))
+      out[[length(out) + 1]] <- list(
+        clave = paste0(fichero, ".", rel), ambito = ambito,
+        nombre = if (is.null(et)) humanizar(camino[length(camino)]) else et$nombre, afecta = et$afecta,
+        estado = x[["estado"]], nivel = nv, norma = x[["norma"]], nota = notas[[rel]])
+    }
+  }
+  for (k in names(x)) {
+    if (k %in% c("meta", "deducciones_autonomicas", "lista")) next
+    if (is.list(x[[k]]) && !is.null(names(x[[k]])))
+      out <- c(out, bloques_con_estado(x[[k]], c(camino, k), fuente, notas, ambito, fichero))
+  }
+  out
+}
+
+# ---- un ejercicio ---------------------------------------------------------------------
+cobertura_ejercicio <- function(ej) {
+  est  <- leer_params(ej, "estatal.yaml");          n_est  <- notas_params(ej, "estatal.yaml")
+  auto <- leer_params(ej, "autonomico.yaml");       n_auto <- notas_params(ej, "autonomico.yaml")
+  pv   <- leer_params(ej, "foral_pais_vasco.yaml"); n_pv   <- notas_params(ej, "foral_pais_vasco.yaml")
+  nv   <- leer_params(ej, "navarra.yaml");          n_nv   <- notas_params(ej, "navarra.yaml")
+
+  parametros <- c(
+    bloques_con_estado(est, character(), NULL, n_est, "estatal", "estatal"),
+    bloques_con_estado(pv, character(), NULL, n_pv, "foral_pv", "foral_pv"),
+    bloques_con_estado(nv, character(), NULL, n_nv, "navarra", "navarra"))
+  # los del País Vasco que cuelgan de un territorio histórico son de ese territorio
+  for (i in seq_along(parametros)) {
+    m <- regmatches(parametros[[i]]$clave, regexec("^foral_pv\\.overrides\\.(ES-PV-[A-Z]+)\\.", parametros[[i]]$clave))[[1]]
+    if (length(m)) parametros[[i]]$ambito <- m[2]
+  }
+
+  territorios <- list()
+  for (t in names(auto$territorios)) {
+    x <- auto$territorios[[t]]
+    da <- x$deducciones_autonomicas
+    pref <- paste0("territorios.", t)
+    notas_t <- n_auto[startsWith(names(n_auto), paste0(pref, "."))]
+    names(notas_t) <- substring(names(notas_t), nchar(pref) + 2)
+    sin_ded <- x; sin_ded$deducciones_autonomicas <- NULL
+    parametros <- c(parametros, lapply(bloques_con_estado(sin_ded, character(), NULL, notas_t, t, "autonomico"),
+      function(b) { b$clave <- sub("^autonomico\\.", paste0("autonomico.", t, "."), b$clave); b }))
+    lista <- lapply(da$lista, function(d) {
+      fuente <- d[["fuente"]] %||% da[["fuente"]]
+      list(id = d$id, norma = d[["norma"]], estado = d[["estado"]] %||% "sin_cotejar",
+           nivel = nivel_de(d[["estado"]], fuente),
+           nota = notas_t[[paste0("deducciones_autonomicas.", d$id)]])
+    })
+    niveles <- vapply(lista, `[[`, "", "nivel")
+    territorios[[t]] <- list(
+      nombre = x$nombre, regimen = "comun",
+      escala = list(estado = x$escala_general_autonomica[["estado"]],
+                    nivel = nivel_de(x$escala_general_autonomica[["estado"]], x$escala_general_autonomica[["fuente"]])),
+      deducciones = list(
+        cargadas = length(lista), verificadas = sum(niveles == "verificado"),
+        no_verificadas = sum(niveles != "verificado"),
+        total_aprox = CATALOGO$total_aprox[[t]],
+        lista = lista))
+  }
+  for (t in c("ES-PV-BI", "ES-PV-SS", "ES-PV-VI"))
+    territorios[[t]] <- list(nombre = pv$overrides[[t]]$nombre, regimen = "foral_pais_vasco")
+  territorios[["ES-NC"]] <- list(nombre = "Comunidad Foral de Navarra", regimen = "foral_navarra")
+
+  list(ejercicio = ej,
+       en_preparacion = identical(est$meta[["estado"]], "en_preparacion") || identical(auto$meta[["estado_ejercicio"]], "en_preparacion"),
+       territorios = territorios, parametros = parametros)
+}
+
+cfg <- ejercicios_config()
+datos <- list(
+  generado = as.character(Sys.Date()),
+  por_defecto = cfg$por_defecto,
+  publicados = I(cfg$publicados),
+  fuente_total_aprox = CATALOGO$total_aprox$fuente,
+  no_cubierto = CATALOGO$no_cubierto,
+  ejercicios = setNames(lapply(ejercicios_disponibles(), cobertura_ejercicio), as.character(ejercicios_disponibles()))
+)
+if (length(sin_etiqueta))
+  message("Aviso: bloques sin etiqueta en tools/cobertura_catalogo.yaml (se muestra la clave): ",
+          paste(sin_etiqueta, collapse = ", "))
+
+# ---- parte automática de docs/02 ----------------------------------------------------------
+NIVEL_TXT <- c(verificado = "✅ verificado", sin_fuente_oficial = "🟠 confirmado, pero la fuente no es oficial",
+               sin_fuente = "🟠 confirmado, sin fuente citada",
+               sin_cotejar = "🟡 sin cotejo individual", provisional = "🟡 provisional",
+               pendiente = "⛔ pendiente", parcial = "🟡 parcial")
+md_doc <- function(d) {
+  l <- c(MARCA_INI, "",
+         sprintf("Recuento generado desde `params/` el %s (ejercicio por defecto: %s).", d$generado, d$por_defecto), "")
+  for (ej in names(d$ejercicios)) {
+    e <- d$ejercicios[[ej]]
+    l <- c(l, sprintf("### Ejercicio %s%s", ej, if (isTRUE(e$en_preparacion)) " (en preparación)" else ""), "",
+           "| Comunidad | Escala | Deducciones cargadas | Verificadas | Sin verificar | Total aprox. (Manual AEAT) |",
+           "|---|---|---|---|---|---|")
+    for (t in names(e$territorios)) {
+      x <- e$territorios[[t]]
+      if (x$regimen != "comun") next
+      dd <- x$deducciones
+      l <- c(l, sprintf("| %s | %s | %d | %d | %d | ~%s |", x$nombre, NIVEL_TXT[[x$escala$nivel]] %||% x$escala$nivel,
+                        dd$cargadas, dd$verificadas, dd$no_verificadas, dd$total_aprox %||% "?"))
+    }
+    tot <- Reduce(`+`, lapply(Filter(function(x) x$regimen == "comun", e$territorios), function(x) x$deducciones$cargadas))
+    ver <- Reduce(`+`, lapply(Filter(function(x) x$regimen == "comun", e$territorios), function(x) x$deducciones$verificadas))
+    l <- c(l, "", sprintf("Total: %d deducciones autonómicas cargadas, %d verificadas.", tot, ver), "",
+           "Parámetros no verificados:", "",
+           "| Ámbito | Parámetro | Estado | Nota |", "|---|---|---|---|")
+    for (p in e$parametros)
+      l <- c(l, sprintf("| %s | %s (`%s`) | %s | %s |", p$ambito, p$nombre, p$clave,
+                        NIVEL_TXT[[p$nivel]] %||% p$nivel, gsub("\\|", "/", p$nota %||% "")))
+    l <- c(l, "")
+  }
+  c(l, MARCA_FIN)
+}
+doc_con <- function(d) {
+  txt <- readLines(DOC, encoding = "UTF-8", warn = FALSE)
+  i <- which(txt == MARCA_INI); f <- which(txt == MARCA_FIN)
+  if (length(i) != 1 || length(f) != 1 || f < i) stop("No encuentro las marcas de la parte automática en ", DOC)
+  c(txt[seq_len(i - 1)], md_doc(d), txt[-seq_len(f)])
+}
+
+json <- function(x) as.character(jsonlite::prettify(
+  jsonlite::toJSON(x, auto_unbox = TRUE, null = "null", digits = NA), indent = 1))
+leer_txt <- function(p) gsub("\r", "", readChar(p, file.size(p), useBytes = TRUE), fixed = TRUE)
+escribir <- function(p, txt) { con <- file(p, "wb"); writeBin(charToRaw(enc2utf8(txt)), con); close(con) }
+
+# `generado` solo cambia si cambia el contenido
+if (file.exists(DESTINO_JSON)) {
+  previo <- jsonlite::fromJSON(leer_txt(DESTINO_JSON), simplifyVector = FALSE)$generado
+  igual <- datos; igual$generado <- previo
+  if (identical(enc2utf8(json(igual)), enc2utf8(leer_txt(DESTINO_JSON))) ||
+      "--comprobar" %in% commandArgs(trailingOnly = TRUE)) datos$generado <- previo
+}
+nuevo_json <- json(datos)
+nuevo_doc <- paste0(paste(doc_con(datos), collapse = "\n"), "\n")
+
+if ("--comprobar" %in% commandArgs(trailingOnly = TRUE)) {
+  mal <- character()
+  if (!file.exists(DESTINO_JSON) || !identical(enc2utf8(leer_txt(DESTINO_JSON)), enc2utf8(nuevo_json))) mal <- c(mal, DESTINO_JSON)
+  if (!identical(enc2utf8(leer_txt(DOC)), enc2utf8(nuevo_doc))) mal <- c(mal, DOC)
+  if (length(mal)) {
+    message(paste(mal, collapse = " y "), " no coincide(n) con params/. Regenera con `Rscript tools/generar_cobertura.R`.")
+    quit(status = 1)
+  }
+  cat(DESTINO_JSON, " y ", DOC, " coinciden con params/\n", sep = "")
+} else {
+  escribir(DESTINO_JSON, nuevo_json)
+  escribir(DOC, nuevo_doc)
+  for (ej in names(datos$ejercicios)) {
+    e <- datos$ejercicios[[ej]]
+    cc <- Filter(function(x) x$regimen == "comun", e$territorios)
+    cat(sprintf("%s: %d deducciones autonómicas cargadas (%d verificadas) en %d CCAA; %d parámetros sin verificar\n", ej,
+      sum(vapply(cc, function(x) x$deducciones$cargadas, 0)), sum(vapply(cc, function(x) x$deducciones$verificadas, 0)),
+      length(cc), length(e$parametros)))
+  }
+}
